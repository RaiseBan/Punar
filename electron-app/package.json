{
  "name": "electron-app",
  "productName": "ElectronApp",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": "dist/electron-app/src/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "clean:all": "rimraf dist electron-cache electron-data",
    "dev": "npm run start",
    "predev:electron": "npm run clean && tsc",
    "dev:electron": "wait-on -t 30000 http://localhost:3000 && electron --no-deprecation . --port=3000",
    "dev:react": "cd ../react-app && npm start",
    "prestart": "npm run clean && tsc",
    "prestart:port": "npm run clean && tsc",
    "start": "cross-env NODE_ENV=development concurrently \"npm run react-start\" \"npm run electron-start\"",
    "start:port": "cross-env NODE_ENV=development concurrently \"npm run react-start\" \"npm run electron-start:port\"",
    "react-start": "cd ../react-app && npm start",
    "react-start:port": "cd ../react-app && cross-env PORT=$npm_config_port react-scripts start",
    "electron-start:port": "wait-on -t 30000 http://localhost:3000 && electron --no-deprecation . --port=3000",
    "electron-start": "wait-on -t 30000 http://localhost:3000 && electron --no-deprecation . --disk-cache-dir=./electron-cache --user-data-dir=./electron-data",
    "build": "cross-env NODE_ENV=production npm run react-build && npm run electron-build",
    "react-build": "cd ../react-app && npm run build",
    "electron-build": "npm run clean && tsc",
    "electron-build-full": "npm run clean && tsc && electron-builder",
    "clear-cache": "rimraf %LOCALAPPDATA%\\electron-builder\\Cache dist electron-cache electron-data",
    "watch-ts": "tsc --watch",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "lint:fix": "eslint 'src/**/*.{ts,js}' --fix",
    "format": "prettier --write 'src/**/*.{ts,js,json}'",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "build": {
    "appId": "com.example.electronapp",
    "productName": "ElectronApp",
    "files": [
      "dist/**/*",
      "../react-app/build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "sign": false
    }
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^23.0.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "rimraf": "^5.0.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.95.4",
    "@types/express": "^5.0.6",
    "axios": "^1.8.1",
    "bs58": "^6.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1"
  }
}
