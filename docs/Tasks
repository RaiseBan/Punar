static async getCollectionNfts({
                                       collectionId,
                                       sort = SortType.LISTING_PRICE_ASC,
                                       limit = 1,
                                       onlyListings = true,
                                       name = "",
                                       minPrice,
                                       maxPrice,
                                   }: EndpointParams): Promise<any> {

        let attempts = 0;

        while (attempts < MAX_ATTEMPTS) {
            try {
                const params = new URLSearchParams();
                params.append("collId", collectionId);
                params.append("sortBy", sort);
                params.append("limit", limit.toString());
                params.append("onlyListings", String(onlyListings));
                if (minPrice) {
                    params.append("minPrice", minPrice.toString());
                }
                if (maxPrice) {
                    params.append("maxPrice", maxPrice.toString());
                }
                params.append("name", name);

                const url = `${TENSOR_GET_NFT_URL}?${params.toString()}`;
                // console.log(`├─🔄Attempt nfts ${attempts + 1}`);

                const response = await fetch(url, this.options);

                if (!response.ok) {
                    console.error(`├─error: ${response.status} ${response.statusText}`);

                    if ([400, 422].includes(response.status)) {
                        // Ошибки 400 и 422 не зависят от повторов, сразу возвращаем ошибку
                        return { error: `Bad Request (${response.status})`, details: await response.text() };
                    }
                    throw new Error(`HTTP ${response.status}`);
                }

                // Проверяем, что контент - JSON
                const contentType = response.headers.get("content-type");
                if (!contentType || !contentType.includes("application/json")) {
                    throw new Error("├─❌ Сервер вернул не JSON-ответ");
                }

                return await response.json();

            } catch (error) {
                console.error(`├─Ошибка при запросе: ${error}. Попытка ${attempts + 1} из ${MAX_ATTEMPTS}`);
                attempts++;

                if (attempts >= MAX_ATTEMPTS) {
                    return { error: "Max attempts reached", details: error };
                }

                // Задержка перед следующей попыткой
                await new Promise(resolve => setTimeout(resolve, 1000));
            }
        }
    }

